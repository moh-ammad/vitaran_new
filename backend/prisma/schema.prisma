generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum SchoolBoard {
  CBSE
  ICSE
  STATE
  IB
  IGCSE
  OTHER
}

enum SchoolType {
  REGULAR
  CUSTOMIZED
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
}

enum Subject {
  MATHEMATICS
  PHYSICS
  CHEMISTRY
  BIOLOGY
  SCIENCE
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
}

/// Admin-managed catalog: name, year, class range and subjects. Fully dynamic.
model LearningProgram {
  id        String    @id @default(uuid()) @db.Uuid
  /// Stable key used on answer keys / results / solution books (e.g. INTEGRATED).
  code      String    @unique @db.VarChar(64)
  name      String    @db.VarChar(120)
  year      Int
  classFrom Int       @map("class_from") @db.SmallInt
  classTo   Int       @map("class_to") @db.SmallInt
  subjects  Subject[]
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  schoolPrograms     SchoolProgram[]
  teacherAssignments TeacherAssignment[]
  classTeachers      ClassTeacher[]

  @@index([year])
  @@index([createdAt])
  @@map("learning_programs")
}

model School {
  id                String       @id @default(uuid()) @db.Uuid
  serial            Int          @unique @default(autoincrement())
  /// Freeform school ID shown to admins (no format restriction).
  code              String       @unique @db.VarChar(64)
  name              String       @db.VarChar(200)
  board             SchoolBoard
  type              SchoolType   @default(REGULAR)
  status            SchoolStatus @default(ACTIVE)
  principalName     String?      @map("principal_name") @db.VarChar(120)
  contactName       String       @map("contact_name") @db.VarChar(120)
  contactEmail      String       @map("contact_email") @db.VarChar(254)
  contactPhone      String       @map("contact_phone") @db.VarChar(20)
  addressLine       String       @map("address_line") @db.VarChar(300)
  city              String       @db.VarChar(100)
  state             String       @db.VarChar(100)
  pincode           String       @db.VarChar(6)
  studentStrength   Int?         @map("student_strength")
  notes             String?      @db.VarChar(1000)
  accountEmail      String?      @unique @map("account_email") @db.VarChar(254)
  accountPhone      String?      @unique @map("account_phone") @db.VarChar(20)
  passwordHash      String?      @map("password_hash") @db.VarChar(255)
  /// AES-256-GCM so admins can view the password; sign-in always checks the hash.
  passwordEncrypted String?      @map("password_encrypted") @db.VarChar(512)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  answerKeys        AnswerKey[]
  resultSets        ResultSet[]
  teachers          Teacher[]
  schoolPrograms    SchoolProgram[]
  classTeachers     ClassTeacher[]

  @@index([status])
  @@index([board])
  @@index([createdAt])
  @@map("schools")
}

/// A school enrolled in a catalog program, with per-class subject selections.
model SchoolProgram {
  id        String              @id @default(uuid()) @db.Uuid
  schoolId  String              @map("school_id") @db.Uuid
  programId String              @map("program_id") @db.Uuid
  school    School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  program   LearningProgram     @relation(fields: [programId], references: [id], onDelete: Restrict)
  classes   SchoolProgramClass[]
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([schoolId, programId])
  @@index([programId])
  @@map("school_programs")
}

model SchoolProgramClass {
  id              String        @id @default(uuid()) @db.Uuid
  schoolProgramId String        @map("school_program_id") @db.Uuid
  classLevel      Int           @map("class_level") @db.SmallInt
  subjects        Subject[]
  schoolProgram   SchoolProgram @relation(fields: [schoolProgramId], references: [id], onDelete: Cascade)

  @@unique([schoolProgramId, classLevel])
  @@map("school_program_classes")
}

/// A teacher belongs to one school and only sees content for their class/subject assignments.
model Teacher {
  id                String              @id @default(uuid()) @db.Uuid
  schoolId          String              @map("school_id") @db.Uuid
  school            School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name              String              @db.VarChar(120)
  email             String              @unique @db.VarChar(254)
  phone             String              @unique @db.VarChar(20)
  status            TeacherStatus       @default(ACTIVE)
  passwordHash      String              @map("password_hash") @db.VarChar(255)
  /// AES-256-GCM so school/admin can view the password; sign-in always checks the hash.
  passwordEncrypted String              @map("password_encrypted") @db.VarChar(512)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignments       TeacherAssignment[]
  classTeacherOf    ClassTeacher[]

  @@index([schoolId])
  @@index([status])
  @@index([createdAt])
  @@map("teachers")
}

/// One program + class + subject the teacher is allowed to see.
model TeacherAssignment {
  id         String          @id @default(uuid()) @db.Uuid
  teacherId  String          @map("teacher_id") @db.Uuid
  programId  String          @map("program_id") @db.Uuid
  teacher    Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  program    LearningProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  classLevel Int             @map("class_level") @db.SmallInt
  subject    Subject

  @@unique([teacherId, programId, classLevel, subject])
  @@index([teacherId])
  @@index([programId])
  @@map("teacher_assignments")
}

/// Teachers marked as class teacher for a school + program + class.
model ClassTeacher {
  id         String          @id @default(uuid()) @db.Uuid
  schoolId   String          @map("school_id") @db.Uuid
  programId  String          @map("program_id") @db.Uuid
  classLevel Int             @map("class_level") @db.SmallInt
  teacherId  String          @map("teacher_id") @db.Uuid
  school     School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  program    LearningProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  teacher    Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([schoolId, programId, classLevel, teacherId])
  @@index([schoolId, programId, classLevel])
  @@index([teacherId])
  @@map("class_teachers")
}

/// Regular keys are shared by every school on the program; customized keys belong to one school.
/// `programCode` matches LearningProgram.code.
/// `testId` + `testNumber` link keys to results for the same school/program/class.
model AnswerKey {
  id          String     @id @default(uuid()) @db.Uuid
  programCode String     @map("program_code") @db.VarChar(64)
  type        SchoolType
  schoolId    String?    @map("school_id") @db.Uuid
  school      School?    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// Human-facing test ID (freeform), shared with results.
  testId      String     @map("test_id") @db.VarChar(64)
  /// Ordinal test number (1–100).
  testNumber  Int        @map("test_number") @db.SmallInt
  classLevel  Int        @map("class_level") @db.SmallInt
  fileName    String     @map("file_name") @db.VarChar(255)
  fileSize    Int        @map("file_size")
  /// PDF bytes; never selected in list queries.
  data        Bytes
  /// Schools only see published answer keys.
  published   Boolean    @default(false)
  publishedAt DateTime?  @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([schoolId])
  @@index([programCode])
  @@index([testId, testNumber])
  @@map("answer_keys")
}

/// One test's results for one school and program; each class is uploaded as its own sheet.
model ResultSet {
  id          String        @id @default(uuid()) @db.Uuid
  schoolId    String        @map("school_id") @db.Uuid
  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// Regular schools pick a catalog program code.
  programCode String?       @map("program_code") @db.VarChar(64)
  /// Customized schools type their own program name.
  programName String?       @map("program_name") @db.VarChar(120)
  /// `programCode`, or the lowercased custom name; keeps one set per school, program and test.
  programKey  String        @map("program_key") @db.VarChar(130)
  /// Human-facing test ID (freeform).
  testId      String        @map("test_id") @db.VarChar(64)
  /// Ordinal test number (1–100).
  testNumber  Int           @map("test_number") @db.SmallInt
  /// Schools only see published results.
  published   Boolean       @default(false)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  sheets      ResultSheet[]

  @@unique([schoolId, programKey, testNumber])
  @@index([updatedAt])
  @@index([programCode])
  @@map("result_sets")
}

/// One class's uploaded spreadsheet: its header row, the original file, and one row per student.
model ResultSheet {
  id          String      @id @default(uuid()) @db.Uuid
  resultSetId String      @map("result_set_id") @db.Uuid
  resultSet   ResultSet   @relation(fields: [resultSetId], references: [id], onDelete: Cascade)
  classLevel  Int         @map("class_level") @db.SmallInt
  /// Title lines above the header row, e.g. "TEST-3 9-SEP-2026 (Max. Marks: 300)".
  caption     String[]    @default([])
  /// Header labels, in column order.
  columns     Json
  rowCount    Int         @map("row_count")
  fileName    String      @map("file_name") @db.VarChar(255)
  fileSize    Int         @map("file_size")
  /// Original .xlsx bytes for download; never selected in list queries.
  data        Bytes
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rows        ResultRow[]

  @@unique([resultSetId, classLevel])
  @@map("result_sheets")
}

model ResultRow {
  sheetId  String      @map("sheet_id") @db.Uuid
  sheet    ResultSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  /// 1-based order within the sheet.
  position Int
  /// Cell values aligned with the sheet's `columns`: string, number, boolean or null.
  values   Json

  @@id([sheetId, position])
  @@map("result_rows")
}
